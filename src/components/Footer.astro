---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---
<footer style="background:#0F3D66; color:#FFFFFF; padding:64px 24px 0;">
  <div style="max-width:1240px; margin:0 auto; display:flex; flex-wrap:wrap; gap:44px; padding-bottom:44px; border-bottom:1px solid rgba(255,255,255,0.14);">
    <div style="flex:1 1 280px;">
      <div style="display:flex; align-items:center; gap:10px;">
        <img src={`${base}logo-mark.png`} alt="Vitara Pharmacy logo" width="36" height="33" style="display:block;" />
        <span class="wordmark" style="font-weight:800; font-size:19px; color:#FFFFFF;">Vitara Pharmacy</span>
      </div>
      <p style="color:#AEC2D6; font-size:15px; line-height:1.65; margin:14px 0 0; max-width:300px;">Health, close to home. Prescriptions, consultations, and everyday wellness for the Naalya community.</p>
    </div>
    <div style="flex:1 1 150px;">
      <div style="font-family:'Funnel Display',sans-serif; font-weight:500; font-size:15px; color:#FFFFFF; margin-bottom:16px;">Company</div>
      <div style="display:flex; flex-direction:column; gap:11px;">
        <a href={`${base}about`} class="footer-link" style="font-size:14.5px;">About us</a>
        <a href={`${base}about#leadership`} class="footer-link" style="font-size:14.5px;">Leadership</a>
        <a href={`${base}careers`} class="footer-link" style="font-size:14.5px;">Careers</a>
        <a href={`${base}news`} class="footer-link" style="font-size:14.5px;">News &amp; press</a>
        <a href={`${base}about#certifications`} class="footer-link" style="font-size:14.5px;">Certifications</a>
      </div>
    </div>
    <div style="flex:1 1 170px;">
      <div style="font-family:'Funnel Display',sans-serif; font-weight:500; font-size:15px; color:#FFFFFF; margin-bottom:16px;">Services</div>
      <div style="display:flex; flex-direction:column; gap:11px;">
        <a href={`${base}services#services`} class="footer-link" style="font-size:14.5px;">Prescription refills</a>
        <a href={`${base}services#services`} class="footer-link" style="font-size:14.5px;">Pharmacist consultations</a>
        <a href={`${base}services#services`} class="footer-link" style="font-size:14.5px;">Home delivery</a>
        <a href={`${base}services#products`} class="footer-link" style="font-size:14.5px;">OTC &amp; wellness</a>
      </div>
    </div>
    <div style="flex:1 1 240px;">
      <div style="font-family:'Funnel Display',sans-serif; font-weight:500; font-size:15px; color:#FFFFFF; margin-bottom:16px;">Visit us</div>
      <div style="display:flex; flex-direction:column; gap:10px; color:#AEC2D6; font-size:14.5px; line-height:1.55;">
        <span>JSM Complex, Naalya<br />Opposite Quality Supermarket<br />Kampala, Uganda</span>
        <a href="tel:+256700123456" class="footer-link">+256 700 123 456</a>
        <a href="mailto:info@vitarapharmacy.co.ug" class="footer-link">info@vitarapharmacy.co.ug</a>
        <span>Mon&ndash;Sat: 8:00am&ndash;9:00pm</span>
      </div>
    </div>
  </div>
  <div style="max-width:1240px; margin:0 auto; padding:20px 0; display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px; color:#7F97AC; font-size:13px;">
    <span>&copy; {year} Vitara Pharmacy. All rights reserved.</span>
    <span>Naalya, Kampala, Uganda</span>
  </div>
</footer>
