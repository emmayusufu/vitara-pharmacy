---
import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
---
<Layout title="About | Vitara Pharmacy" description="Vitara Pharmacy is a community pharmacy in Naalya, Kampala built on trust, care, and easy access to the medicine our neighbors need." active="about">
<div style="font-family:'Nunito',sans-serif; color:#10161C;">

  <section style="position:relative; overflow:hidden; padding:72px 24px 64px; background:#F6F9FC;">
    <div style="position:absolute; top:-120px; right:-100px; width:340px; height:340px; border-radius:42% 58% 63% 37% / 45% 45% 55% 55%; background:#EAF3FB; z-index:0;"></div>
    <div style="position:relative; z-index:1; max-width:760px; margin:0 auto; text-align:center;">
      <span style="display:inline-block; background:#E7F7EF; color:#167A52; font-size:14px; font-weight:700; padding:7px 16px; border-radius:8px;">About us</span>
      <h1 class="page-title" style="font-weight:600; font-size:44px; line-height:1.15; margin:20px 0 0; color:#0F3D66;">About Vitara Pharmacy</h1>
      <p class="lede" style="line-height:1.65; color:#4B5563; margin:18px 0 0;">A community pharmacy built on trust, care, and easy access to the medicine our neighbors need.</p>
    </div>
  </section>

  <section style="padding:80px 24px; text-align:center;">
    <div style="max-width:720px; margin:0 auto;">
      <span style="font-size:14px; font-weight:700; color:#1E9E6B;">Our motto</span>
      <h2 style="font-weight:600; font-size:38px; margin:14px 0 0; color:#10161C; line-height:1.25;">&quot;Health, close to home.&quot;</h2>
    </div>
  </section>

  <section id="vision-mission" style="padding:0 24px 90px;">
    <div style="max-width:1240px; margin:0 auto; display:flex; flex-wrap:wrap; gap:28px;">
      <div style="flex:1 1 320px; background:#FFFFFF; border-radius:20px; padding:38px; border:1px solid #E4E9ED; box-shadow:0 1px 2px rgba(16,22,28,0.04);">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#1768B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
        <h3 style="font-weight:600; font-size:23px; margin:18px 0 10px; color:#0F3D66;">Vision</h3>
        <p style="font-size:16px; color:#4B5563; line-height:1.7; margin:0;">To be the most trusted community pharmacy network in Uganda, making quality healthcare accessible to every neighborhood.</p>
      </div>
      <div style="flex:1 1 320px; background:#FFFFFF; border-radius:20px; padding:38px; border:1px solid #E4E9ED; box-shadow:0 1px 2px rgba(16,22,28,0.04);">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#1E9E6B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.35-9.5-8.5C.7 8.2 2.4 5 5.6 5c1.9 0 3.2 1 4.4 2.5C11.2 6 12.5 5 14.4 5c3.2 0 4.9 3.2 3.1 6.5C19 15.65 12 20 12 20z"/></svg>
        <h3 style="font-weight:600; font-size:23px; margin:18px 0 10px; color:#0F3D66;">Mission</h3>
        <p style="font-size:16px; color:#4B5563; line-height:1.7; margin:0;">To provide safe, affordable, and compassionate pharmaceutical care while empowering our communities to live healthier lives.</p>
      </div>
    </div>
  </section>

  <section id="leadership" style="padding:0 24px 90px; background:#F6F9FC; padding-top:80px;">
    <div style="max-width:1240px; margin:0 auto;">
      <div style="max-width:560px; margin:0 auto 44px; text-align:center;">
        <h2 style="font-weight:600; font-size:34px; margin:0; color:#10161C;">Leadership team</h2>
        <p style="font-size:16.5px; color:#4B5563; margin:12px 0 0;">The people guiding care at Vitara Pharmacy.</p>
      </div>
      <div style="display:flex; flex-wrap:wrap; gap:24px; justify-content:center;">
        <div style="flex:1 1 230px; max-width:260px; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; padding:26px; text-align:center;">
          <ImageSlot shape="circle" label="Photo" style="width:96px; height:96px; margin:0 auto;" />
          <h3 style="font-weight:500; font-size:17px; margin:16px 0 2px;">Grace Nakato</h3>
          <p style="font-size:14.5px; color:#6B7280; margin:0;">Chief Pharmacist</p>
        </div>
        <div style="flex:1 1 230px; max-width:260px; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; padding:26px; text-align:center;">
          <ImageSlot shape="circle" label="Photo" style="width:96px; height:96px; margin:0 auto;" />
          <h3 style="font-weight:500; font-size:17px; margin:16px 0 2px;">Michael Okello</h3>
          <p style="font-size:14.5px; color:#6B7280; margin:0;">Operations Manager</p>
        </div>
        <div style="flex:1 1 230px; max-width:260px; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; padding:26px; text-align:center;">
          <ImageSlot shape="circle" label="Photo" style="width:96px; height:96px; margin:0 auto;" />
          <h3 style="font-weight:500; font-size:17px; margin:16px 0 2px;">Sarah Achieng</h3>
          <p style="font-size:14.5px; color:#6B7280; margin:0;">Compliance Lead</p>
        </div>
        <div style="flex:1 1 230px; max-width:260px; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; padding:26px; text-align:center;">
          <ImageSlot shape="circle" label="Photo" style="width:96px; height:96px; margin:0 auto;" />
          <h3 style="font-weight:500; font-size:17px; margin:16px 0 2px;">David Mugisha</h3>
          <p style="font-size:14.5px; color:#6B7280; margin:0;">Pharmacy Manager</p>
        </div>
      </div>
    </div>
  </section>

  <section id="certifications" style="padding:88px 24px;">
    <div style="max-width:1240px; margin:0 auto;">
      <div style="max-width:560px; margin:0 auto 44px; text-align:center;">
        <h2 style="font-weight:600; font-size:34px; margin:0; color:#10161C;">Certifications &amp; compliance</h2>
        <p style="font-size:16.5px; color:#4B5563; margin:12px 0 0;">Held to national standards for pharmaceutical care.</p>
      </div>
      <div style="display:flex; flex-wrap:wrap; gap:24px;">
        <div style="flex:1 1 280px; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; padding:30px; display:flex; gap:16px; align-items:flex-start;">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#1768B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M12 3l7 3v6c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V6l7-3z"/></svg>
          <div>
            <h3 style="font-weight:500; font-size:16.5px; margin:0 0 6px;">National Drug Authority</h3>
            <p style="font-size:14.5px; color:#4B5563; line-height:1.55; margin:0;">Fully licensed to dispense pharmaceuticals in Uganda.</p>
          </div>
        </div>
        <div style="flex:1 1 280px; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; padding:30px; display:flex; gap:16px; align-items:flex-start;">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#1E9E6B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M12 3l7 3v6c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V6l7-3z"/></svg>
          <div>
            <h3 style="font-weight:500; font-size:16.5px; margin:0 0 6px;">Good Pharmacy Practice</h3>
            <p style="font-size:14.5px; color:#4B5563; line-height:1.55; margin:0;">Certified against national dispensing and storage standards.</p>
          </div>
        </div>
        <div style="flex:1 1 280px; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; padding:30px; display:flex; gap:16px; align-items:flex-start;">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#1768B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M12 3l7 3v6c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V6l7-3z"/></svg>
          <div>
            <h3 style="font-weight:500; font-size:16.5px; margin:0 0 6px;">Pharmaceutical Society Member</h3>
            <p style="font-size:14.5px; color:#4B5563; line-height:1.55; margin:0;">Active member of the Uganda Pharmaceutical Society.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>
</Layout>
