---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Careers | Vitara Pharmacy" description="Vitara Pharmacy in Naalya, Kampala has no open positions right now. Send your CV and we'll reach out when something opens up." active="careers">
<div style="font-family:'Nunito',sans-serif; color:#10161C;">

  <section style="position:relative; overflow:hidden; padding:72px 24px 64px; background:#F6F9FC;">
    <div style="position:absolute; top:-120px; right:-100px; width:340px; height:340px; border-radius:42% 58% 63% 37% / 45% 45% 55% 55%; background:#EAF3FB; z-index:0;"></div>
    <div style="position:relative; z-index:1; max-width:760px; margin:0 auto; text-align:center;">
      <span style="display:inline-block; background:#E7F7EF; color:#167A52; font-size:14px; font-weight:700; padding:7px 16px; border-radius:8px;">Careers</span>
      <h1 class="page-title" style="font-weight:600; font-size:44px; line-height:1.15; margin:20px 0 0; color:#0F3D66;">Build your career with us</h1>
      <p style="font-size:17px; line-height:1.65; color:#4B5563; margin:18px 0 0;">Join a team that's making healthcare more accessible in Naalya, one patient at a time.</p>
    </div>
  </section>

  <section style="padding:80px 24px;">
    <div style="max-width:1240px; margin:0 auto; display:flex; flex-wrap:wrap; gap:24px;">
      <div style="flex:1 1 240px; text-align:center; padding:16px;">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="#1768B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto;"><path d="M12 20s-7-4.35-9.5-8.5C.7 8.2 2.4 5 5.6 5c1.9 0 3.2 1 4.4 2.5C11.2 6 12.5 5 14.4 5c3.2 0 4.9 3.2 3.1 6.5C19 15.65 12 20 12 20z"/></svg>
        <h3 style="font-weight:500; font-size:17px; margin:14px 0 6px;">Meaningful work</h3>
        <p style="font-size:14.5px; color:#4B5563; line-height:1.55; margin:0;">Help neighbors get the care they need, every day.</p>
      </div>
      <div style="flex:1 1 240px; text-align:center; padding:16px;">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="#1E9E6B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto;"><path d="M3 12h4l2-5 4 10 2-5h6"/></svg>
        <h3 style="font-weight:500; font-size:17px; margin:14px 0 6px;">Room to grow</h3>
        <p style="font-size:14.5px; color:#4B5563; line-height:1.55; margin:0;">Clear paths from technician to pharmacist to manager.</p>
      </div>
      <div style="flex:1 1 240px; text-align:center; padding:16px;">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="#1768B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto;"><path d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H9l-4 4V6z"/></svg>
        <h3 style="font-weight:500; font-size:17px; margin:14px 0 6px;">Supportive team</h3>
        <p style="font-size:14.5px; color:#4B5563; line-height:1.55; margin:0;">Work alongside pharmacists who mentor and share knowledge.</p>
      </div>
      <div style="flex:1 1 240px; text-align:center; padding:16px;">
        <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="#1E9E6B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto;"><path d="M12 3l7 3v6c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V6l7-3z"/></svg>
        <h3 style="font-weight:500; font-size:17px; margin:14px 0 6px;">Ongoing training</h3>
        <p style="font-size:14.5px; color:#4B5563; line-height:1.55; margin:0;">Stay current with certifications and product knowledge.</p>
      </div>
    </div>
  </section>

  <section id="openings" style="padding:0 24px 96px; background:#F6F9FC; padding-top:80px;">
    <div style="max-width:560px; margin:0 auto; text-align:center;">
      <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#8A96A1" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto;"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/></svg>
      <h2 style="font-weight:600; font-size:28px; margin:16px 0 0; color:#10161C;">No open positions right now</h2>
      <p style="font-size:16px; color:#4B5563; margin:14px 0 26px; line-height:1.6;">We're not hiring at the moment, but we're always glad to hear from people who care about community healthcare. Send your CV and we'll reach out when something opens up.</p>
      <a href="mailto:vitarahealthgroupltd@gmail.com" class="btn-green" style="padding:15px 28px; border-radius:12px; font-size:16px; display:inline-block;">vitarahealthgroupltd@gmail.com</a>
    </div>
  </section>

</div>
</Layout>
