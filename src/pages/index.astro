---
import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Vitara Pharmacy | Health, close to home" description="Vitara Pharmacy is a community pharmacy in Naalya, Kampala offering prescriptions, pharmacist consultations, home delivery, and everyday wellness products." active="home">
<div style="font-family:'Nunito',sans-serif; color:#10161C;">

  <section style="padding:28px 24px 0;">
    <div class="cta-panel" style="max-width:1240px; margin:0 auto; background:#0F3D66; border-radius:28px; padding:56px; position:relative; overflow:hidden;">
      <div style="position:absolute; top:-100px; right:-80px; width:280px; height:280px; border-radius:50%; background:#1E9E6B; opacity:0.16; z-index:0;"></div>
      <div style="position:relative; z-index:1; display:flex; flex-wrap:wrap; align-items:center; gap:48px;">
        <div style="flex:1 1 420px; min-width:0;">
          <h1 class="wordmark hero-title" style="font-weight:600; font-size:clamp(34px,4.2vw,50px); line-height:1.12; margin:0; color:#FFFFFF;">Health, close to home.</h1>
          <p style="font-size:17px; line-height:1.65; color:#C7D6E4; margin:20px 0 0; max-width:440px;">Vitara Pharmacy is your neighborhood partner for prescriptions, consultations, and everyday wellness, right in Naalya.</p>
          <a href={`${base}contact/#location`} class="btn-white" style="display:inline-flex; align-items:center; gap:8px; padding:15px 28px; border-radius:999px; font-size:16px; margin-top:28px;">Find our store<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
        </div>
        <div style="flex:1 1 380px; min-width:280px; position:relative;">
          <ImageSlot shape="rect" label="Photo: pharmacist assisting a customer" style="width:100%; aspect-ratio:4/3; border-radius:20px;" />
          <div style="position:absolute; right:-16px; bottom:-24px; background:#FFFFFF; border-radius:16px; padding:16px 20px; display:flex; align-items:center; gap:12px; box-shadow:0 16px 32px -10px rgba(0,0,0,0.3); max-width:230px;">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#1E9E6B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M12 3l7 3v6c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V6l7-3z"/></svg>
            <span style="font-size:13.5px; font-weight:700; color:#10161C; line-height:1.3;">Licensed pharmacists on site</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="padding:48px 24px 64px;">
    <div style="max-width:1240px; margin:0 auto; display:flex; flex-wrap:wrap; justify-content:center; gap:32px;">
      <a href={`${base}services/#products`} style="display:flex; flex-direction:column; align-items:center; gap:12px; text-decoration:none; color:#10161C; width:110px;">
        <span style="width:72px; height:72px; border-radius:50%; background:#EAF3FB; display:flex; align-items:center; justify-content:center;"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#1768B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.35-9.5-8.5C.7 8.2 2.4 5 5.6 5c1.9 0 3.2 1 4.4 2.5C11.2 6 12.5 5 14.4 5c3.2 0 4.9 3.2 3.1 6.5C19 15.65 12 20 12 20z"/></svg></span>
        <span style="font-size:14px; font-weight:700; text-align:center;">Vitamins &amp; supplements</span>
      </a>
      <a href={`${base}services/#products`} style="display:flex; flex-direction:column; align-items:center; gap:12px; text-decoration:none; color:#10161C; width:110px;">
        <span style="width:72px; height:72px; border-radius:50%; background:#E7F7EF; display:flex; align-items:center; justify-content:center;"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#1E9E6B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/></svg></span>
        <span style="font-size:14px; font-weight:700; text-align:center;">Personal care</span>
      </a>
      <a href={`${base}services/#products`} style="display:flex; flex-direction:column; align-items:center; gap:12px; text-decoration:none; color:#10161C; width:110px;">
        <span style="width:72px; height:72px; border-radius:50%; background:#EAF3FB; display:flex; align-items:center; justify-content:center;"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#1768B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H9l-4 4V6z"/></svg></span>
        <span style="font-size:14px; font-weight:700; text-align:center;">Baby &amp; maternal</span>
      </a>
      <a href={`${base}services/#products`} style="display:flex; flex-direction:column; align-items:center; gap:12px; text-decoration:none; color:#10161C; width:110px;">
        <span style="width:72px; height:72px; border-radius:50%; background:#E7F7EF; display:flex; align-items:center; justify-content:center;"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#1E9E6B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-5 4 10 2-5h6"/></svg></span>
        <span style="font-size:14px; font-weight:700; text-align:center;">Medical devices</span>
      </a>
    </div>
  </section>

  <section style="padding:0 24px 80px;">
    <div style="max-width:1240px; margin:0 auto; display:flex; flex-wrap:wrap; gap:28px; border-top:1px solid #E4E9ED; border-bottom:1px solid #E4E9ED; padding:32px 0;">
      <div style="flex:1 1 220px; display:flex; align-items:center; gap:14px;">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#1768B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V6l7-3z"/></svg>
        <span style="font-size:15.5px; font-weight:600; color:#2A323B;">Licensed by the National Drug Authority</span>
      </div>
      <div style="flex:1 1 220px; display:flex; align-items:center; gap:14px;">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#1E9E6B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg>
        <span style="font-size:15.5px; font-weight:600; color:#2A323B;">Open 7 days a week</span>
      </div>
      <div style="flex:1 1 220px; display:flex; align-items:center; gap:14px;">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#1768B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v8H3z"/><path d="M14 10h4l3 3v2h-7z"/><circle cx="7.5" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
        <span style="font-size:15.5px; font-weight:600; color:#2A323B;">Home delivery available</span>
      </div>
    </div>
  </section>

  <section style="padding:0 24px 88px;">
    <div style="max-width:1240px; margin:0 auto;">
      <div style="max-width:560px; margin:0 auto 44px; text-align:center;">
        <h2 style="font-weight:600; font-size:34px; margin:0; color:#10161C;">How we can help</h2>
        <p style="font-size:16.5px; color:#4B5563; margin:12px 0 0;">Everything you need for your family's health, under one roof.</p>
      </div>
      <div style="display:flex; flex-wrap:wrap; gap:24px;">
        <div style="flex:1 1 260px; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; padding:30px; box-shadow:0 1px 2px rgba(16,22,28,0.04);">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#1768B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="8.5" width="19" height="7" rx="3.5" transform="rotate(-40 12 12)"/><line x1="12" y1="6.7" x2="12" y2="17.3" transform="rotate(-40 12 12)"/></svg>
          <h3 style="font-weight:500; font-size:19px; margin:16px 0 8px;">Prescription refills</h3>
          <p style="font-size:15px; color:#4B5563; line-height:1.55; margin:0;">Fast, accurate filling of new and repeat prescriptions.</p>
        </div>
        <div style="flex:1 1 260px; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; padding:30px; box-shadow:0 1px 2px rgba(16,22,28,0.04);">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#1E9E6B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H9l-4 4V6z"/></svg>
          <h3 style="font-weight:500; font-size:19px; margin:16px 0 8px;">Pharmacist consultations</h3>
          <p style="font-size:15px; color:#4B5563; line-height:1.55; margin:0;">One-on-one guidance on medicines, dosage, and interactions.</p>
        </div>
        <div style="flex:1 1 260px; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; padding:30px; box-shadow:0 1px 2px rgba(16,22,28,0.04);">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#1768B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v8H3z"/><path d="M14 10h4l3 3v2h-7z"/><circle cx="7.5" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
          <h3 style="font-weight:500; font-size:19px; margin:16px 0 8px;">Home delivery</h3>
          <p style="font-size:15px; color:#4B5563; line-height:1.55; margin:0;">Medicine brought straight to your door across Naalya.</p>
        </div>
        <div style="flex:1 1 260px; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; padding:30px; box-shadow:0 1px 2px rgba(16,22,28,0.04);">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#1E9E6B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.35-9.5-8.5C.7 8.2 2.4 5 5.6 5c1.9 0 3.2 1 4.4 2.5C11.2 6 12.5 5 14.4 5c3.2 0 4.9 3.2 3.1 6.5C19 15.65 12 20 12 20z"/></svg>
          <h3 style="font-weight:500; font-size:19px; margin:16px 0 8px;">OTC &amp; wellness</h3>
          <p style="font-size:15px; color:#4B5563; line-height:1.55; margin:0;">Vitamins, personal care, and everyday health products.</p>
        </div>
      </div>
      <div style="text-align:center; margin-top:36px;">
        <a href={`${base}services/`} class="text-link" style="font-size:15.5px;">See all services &rarr;</a>
      </div>
    </div>
  </section>

  <section style="padding:0 24px 88px;">
    <div style="max-width:1240px; margin:0 auto; display:flex; flex-wrap:wrap; gap:24px;">
      <div style="flex:1 1 320px; background:#EAF3FB; border-radius:20px; padding:32px; display:flex; flex-direction:column; gap:10px;">
        <span style="font-size:13px; font-weight:700; color:#1768B3;">Every order</span>
        <h3 style="font-weight:600; font-size:22px; margin:0; color:#0F3D66;">Free delivery across Naalya</h3>
        <p style="font-size:14.5px; color:#4B5563; margin:0 0 8px; max-width:38ch;">Order your prescription and we'll bring it straight to your door.</p>
        <a href={`${base}contact/`} class="text-link" style="font-size:14.5px;">Get in touch &rarr;</a>
      </div>
      <div style="flex:1 1 320px; background:#E7F7EF; border-radius:20px; padding:32px; display:flex; flex-direction:column; gap:10px;">
        <span style="font-size:13px; font-weight:700; color:#167A52;">This month</span>
        <h3 style="font-weight:600; font-size:22px; margin:0; color:#0F3D66;">Free blood pressure screening</h3>
        <p style="font-size:14.5px; color:#4B5563; margin:0 0 8px; max-width:38ch;">Drop by anytime, no appointment needed.</p>
        <a href={`${base}news/`} style="color:#167A52; font-weight:700; font-size:14.5px; text-decoration:none;">Learn more &rarr;</a>
      </div>
    </div>
  </section>

  <section style="padding:0 24px 88px; background:#F6F9FC; padding-top:80px;">
    <div style="max-width:1240px; margin:0 auto; display:flex; flex-wrap:wrap; gap:28px;">
      <div style="flex:1 1 320px; background:#FFFFFF; border-radius:20px; padding:36px; border:1px solid #E4E9ED;">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#1768B3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
        <h3 style="font-weight:600; font-size:22px; margin:16px 0 10px; color:#0F3D66;">Our vision</h3>
        <p style="font-size:15.5px; color:#4B5563; line-height:1.65; margin:0;">To be the most trusted community pharmacy network in Uganda, making quality healthcare accessible to every neighborhood.</p>
      </div>
      <div style="flex:1 1 320px; background:#FFFFFF; border-radius:20px; padding:36px; border:1px solid #E4E9ED;">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#1E9E6B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.35-9.5-8.5C.7 8.2 2.4 5 5.6 5c1.9 0 3.2 1 4.4 2.5C11.2 6 12.5 5 14.4 5c3.2 0 4.9 3.2 3.1 6.5C19 15.65 12 20 12 20z"/></svg>
        <h3 style="font-weight:600; font-size:22px; margin:16px 0 10px; color:#0F3D66;">Our mission</h3>
        <p style="font-size:15.5px; color:#4B5563; line-height:1.65; margin:0;">To provide safe, affordable, and compassionate pharmaceutical care while empowering our communities to live healthier lives.</p>
      </div>
      <div style="flex:1 1 100%; text-align:center; margin-top:4px;">
        <a href={`${base}about/`} class="text-link" style="font-size:15.5px;">Learn more about us &rarr;</a>
      </div>
    </div>
  </section>

  <section style="padding:88px 24px;">
    <div style="max-width:1240px; margin:0 auto;">
      <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:36px;">
        <h2 style="font-weight:600; font-size:34px; margin:0; color:#10161C;">Latest at Vitara</h2>
        <a href={`${base}news/`} class="text-link" style="font-size:15px;">View all news &rarr;</a>
      </div>
      <div style="display:flex; flex-wrap:wrap; gap:24px;">
        <a href={`${base}news/`} style="flex:1 1 300px; text-decoration:none; color:inherit; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; overflow:hidden; display:block;">
          <ImageSlot shape="rect" label="Photo: new pickup counter" style="width:100%; height:170px;" />
          <div style="padding:22px;">
            <span style="font-size:13px; color:#8A96A1; font-weight:600;">Aug 2026</span>
            <h3 style="font-weight:500; font-size:16.5px; margin:8px 0 0; color:#10161C; line-height:1.4;">A faster counter for prescription pickup</h3>
          </div>
        </a>
        <a href={`${base}news/`} style="flex:1 1 300px; text-decoration:none; color:inherit; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; overflow:hidden; display:block;">
          <ImageSlot shape="rect" label="Photo: blood pressure screening" style="width:100%; height:170px;" />
          <div style="padding:22px;">
            <span style="font-size:13px; color:#8A96A1; font-weight:600;">Jul 2026</span>
            <h3 style="font-weight:500; font-size:16.5px; margin:8px 0 0; color:#10161C; line-height:1.4;">Free blood pressure screening week returns</h3>
          </div>
        </a>
        <a href={`${base}news/`} style="flex:1 1 300px; text-decoration:none; color:inherit; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; overflow:hidden; display:block;">
          <ImageSlot shape="rect" label="Photo: seasonal vaccination" style="width:100%; height:170px;" />
          <div style="padding:22px;">
            <span style="font-size:13px; color:#8A96A1; font-weight:600;">Jul 2026</span>
            <h3 style="font-weight:500; font-size:16.5px; margin:8px 0 0; color:#10161C; line-height:1.4;">Seasonal flu vaccination now available</h3>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section style="padding:0 24px 96px;">
    <div class="cta-panel" style="max-width:1240px; margin:0 auto; background:#0F3D66; border-radius:28px; padding:56px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:28px; position:relative; overflow:hidden;">
      <div style="position:absolute; top:-80px; right:-60px; width:260px; height:260px; border-radius:50%; background:#1E9E6B; opacity:0.18;"></div>
      <div style="position:relative; z-index:1; max-width:520px;">
        <h2 style="font-weight:600; font-size:30px; margin:0; color:#FFFFFF;">Visit us today</h2>
        <p style="font-size:16px; color:#C7D6E4; margin:12px 0 0; line-height:1.6;">JSM Complex, Naalya &mdash; opposite Quality Shopping Village, Nakawa Division, Kampala.</p>
      </div>
      <a href={`${base}contact/#location`} class="btn-white" style="position:relative; z-index:1; padding:16px 30px; border-radius:12px; font-size:16px; flex-shrink:0;">Get directions</a>
    </div>
  </section>

</div>
</Layout>
