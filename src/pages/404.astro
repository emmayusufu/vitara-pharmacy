---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Page not found | Vitara Pharmacy" description="The page you're looking for doesn't exist." noindex={true}>
<div style="font-family:'Nunito',sans-serif; color:#10161C;">
  <section style="padding:120px 24px; text-align:center;">
    <span style="display:inline-block; background:#E7F7EF; color:#167A52; font-size:14px; font-weight:700; padding:7px 16px; border-radius:8px;">404</span>
    <h1 style="font-weight:600; font-size:38px; line-height:1.2; margin:20px 0 0; color:#0F3D66;">We couldn't find that page</h1>
    <p style="font-size:17px; line-height:1.65; color:#4B5563; margin:16px auto 0; max-width:480px;">The page you're looking for may have moved or no longer exists.</p>
    <div style="display:flex; flex-wrap:wrap; gap:14px; justify-content:center; margin-top:32px;">
      <a href={base} class="btn-primary" style="padding:15px 28px; border-radius:12px; font-size:16px;">Back to home</a>
      <a href={`${base}contact/`} class="btn-outline" style="padding:15px 28px; border-radius:12px; font-size:16px;">Contact us</a>
    </div>
  </section>
</div>
</Layout>
