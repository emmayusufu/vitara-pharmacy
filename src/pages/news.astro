---
import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';

const posts = [
  { date: 'August 2026', title: 'A faster counter for prescription pickup', body: 'A dedicated pickup counter now means shorter waits for repeat prescriptions.', label: 'Photo: prescription pickup counter' },
  { date: 'July 2026', title: 'Free blood pressure screening week returns', body: 'Drop by for a free check, no appointment needed.', label: 'Photo: blood pressure screening' },
  { date: 'July 2026', title: 'Extended hours, now open seven days a week', body: "We've extended our hours so care is available every day.", label: 'Photo: extended store hours' },
  { date: 'June 2026', title: 'Partnering with local clinics for easier referrals', body: 'New referral pathways make it simpler to fill prescriptions after a clinic visit.', label: 'Photo: clinic partnership' },
  { date: 'June 2026', title: 'Seasonal flu vaccination now available', body: 'Walk in for a flu vaccine, administered by our licensed pharmacists.', label: 'Photo: flu vaccination' },
  { date: 'May 2026', title: 'A note on upcoming holiday hours', body: 'Check our updated hours ahead of the public holiday.', label: 'Photo: storefront during holidays' },
];
---
<Layout title="News &amp; Press | Vitara Pharmacy" description="Updates from Vitara Pharmacy's store, team, and community health programs in Naalya, Kampala." active="news">
<div style="font-family:'Nunito',sans-serif; color:#10161C;">

  <section style="position:relative; overflow:hidden; padding:72px 24px 64px; background:#F6F9FC;">
    <div style="position:absolute; top:-120px; left:-100px; width:340px; height:340px; border-radius:58% 42% 45% 55% / 55% 45% 58% 42%; background:#E7F7EF; z-index:0;"></div>
    <div style="position:relative; z-index:1; max-width:760px; margin:0 auto; text-align:center;">
      <span style="display:inline-block; background:#EAF3FB; color:#1768B3; font-size:14px; font-weight:700; padding:7px 16px; border-radius:8px;">News &amp; press</span>
      <h1 class="page-title" style="font-weight:600; font-size:44px; line-height:1.15; margin:20px 0 0; color:#0F3D66;">What's new at Vitara Pharmacy</h1>
      <p style="font-size:17px; line-height:1.65; color:#4B5563; margin:18px 0 0;">Updates from our store, our team, and our community programs.</p>
    </div>
  </section>

  <section style="padding:80px 24px;">
    <div style="max-width:1240px; margin:0 auto; display:flex; flex-wrap:wrap; gap:28px;">
      {posts.map((post) => (
        <div style="flex:1 1 340px; background:#FFFFFF; border:1px solid #E4E9ED; border-radius:18px; overflow:hidden;">
          <ImageSlot shape="rect" label={post.label} style="width:100%; height:190px;" />
          <div style="padding:24px;">
            <span style="font-size:13px; color:#8A96A1; font-weight:600;">{post.date}</span>
            <h3 style="font-weight:500; font-size:18px; margin:10px 0 8px; line-height:1.4;">{post.title}</h3>
            <p style="font-size:14.5px; color:#4B5563; line-height:1.6; margin:0;">{post.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

</div>
</Layout>
